# Supabase (required for CMS + forms + image uploads)
WDA_SUPABASE_URL=https://your-project.supabase.co
WDA_SUPABASE_ANON_KEY=your-anon-key
WDA_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Image uploads need the service role key + a public "media" Storage bucket.

# NextAuth admin login (required for /admin)
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Optional bootstrap admin (until users exist in Supabase)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Fee payments dashboard at /payments (separate from CMS admin)
FEE_DASHBOARD_EMAIL=payments@warriorsdefenceacademy.com
FEE_DASHBOARD_PASSWORD=change-me

# Razorpay (seat-booking payment on the /register form)
# Dashboard -> Settings -> API Keys. Use Test keys until KYC is approved.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard -> Settings -> Webhooks -> add {your-domain}/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Same value as RAZORPAY_KEY_ID (Key Id is public by design). Required for Checkout.
# create-order falls back to RAZORPAY_KEY_ID if this is unset, but set both in Vercel.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Optional AI assistant keys
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
